{
  "name": "@questlearn/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared environment validation, TypeScript, ESLint and Prettier configuration for QuestLearn apps",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests in @questlearn/config\" && exit 0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "typescript-eslint": "^8.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "@types/node": "^22.7.5"
  }
}
