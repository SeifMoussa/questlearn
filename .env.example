# Copy this file to .env and adjust as needed for local development.
# .env is gitignored — never commit real secrets.

NODE_ENV=development
PORT=4000

# Points at the Postgres service defined in docker-compose.yml
DATABASE_URL=postgresql://questlearn:questlearn@localhost:5432/questlearn

# Points at the Redis service defined in docker-compose.yml
REDIS_URL=redis://localhost:6379

# Generate real random values for these locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=replace-with-a-random-32-byte-secret
JWT_SECRET=replace-with-a-different-random-32-byte-secret

API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Consumed by apps/web at build/runtime to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Rate limit for /auth/register, /auth/login, /auth/forgot-password,
# and /classes/join (join-code redemption). Does NOT cover /auth/refresh
# (never overridden -- see auth.controller.ts) or plain GET reads; those
# fall under GLOBAL_THROTTLE_LIMIT below.
# Raised from 30 to 40/60s in Module 7; re-verified empirically against
# this audit-fix pass's added Playwright test and still holds at 40, so
# left unchanged. Still a real brute-force deterrent; production should
# set its own value via the deployment platform's secret manager.
AUTH_THROTTLE_LIMIT=40
AUTH_THROTTLE_TTL_MS=60000

# App-wide default rate limit -- every endpoint without its own
# per-route throttle override, notably /auth/refresh and every plain
# GET read. 100/60s (the schema default, matching what was previously
# a hardcoded literal) is what production gets if this is left unset.
# Raised here for local dev/test: reproduced, with Redis's throttle
# state freshly flushed (not cross-run bleed from repeated manual
# verification), a 429 on /auth/refresh partway through a single clean
# 10-file Playwright suite run once this audit-fix pass's PR added one
# more test to reports.spec.ts. Same posture as AUTH_THROTTLE_LIMIT:
# a real limit in production, loosened here only for the growing
# suite's page-load/API-call volume.
GLOBAL_THROTTLE_LIMIT=300
GLOBAL_THROTTLE_TTL_MS=60000
