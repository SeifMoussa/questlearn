// Prisma schema for the QuestLearn API.
//
// Every non-global table carries tenant_id, per Master Spec §6.1 (A4) —
// the platform only has one tenant type ("teacher workspace") today, but
// every row is scoped so the model is multi-tenant-correct from the start.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  teacher
  learner
}

enum TenantPlan {
  free
}

/// A tenant is a teacher's workspace. Only teacher registration ever
/// creates a new tenant; learners who redeem a join code join an
/// existing tenant (their teacher's) rather than creating one.
model Tenant {
  id        String     @id @default(uuid())
  name      String
  plan      TenantPlan @default(free)
  createdAt DateTime   @default(now()) @map("created_at")

  users                User[]
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  sessions             Session[]
  classes              Class[]
  rosterEntries        RosterEntry[]
  questions            Question[]
  questionVersions     QuestionVersion[]
  activities           Activity[]
  activityQuestions    ActivityQuestion[]
  assignments          Assignment[]
  attempts             Attempt[]
  attemptResponses     AttemptResponse[]
  concepts             Concept[]
  questionConcepts     QuestionConcept[]
  masteryEvidence      MasteryEvidence[]

  @@map("tenants")
}

model User {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  email           String
  name            String
  passwordHash    String    @map("password_hash")
  role            UserRole  @default(teacher)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions             Session[]
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  classes              Class[]
  questions            Question[]
  activities           Activity[]
  rosterEntries        RosterEntry[]
  assignments          Assignment[]
  attempts             Attempt[]
  concepts             Concept[]
  masteryEvidence      MasteryEvidence[] @relation("MasteryEvidenceLearner")

  // Email uniqueness is scoped globally (login is by email alone, no
  // tenant selector in Module 1), not per-tenant.
  @@unique([email])
  @@index([tenantId])
  @@map("users")
}

/// Refresh tokens, stored hashed — never plaintext at rest. Rotated on
/// every use; the old row is marked revoked rather than deleted so a
/// reuse of a stale token can be detected.
model Session {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  userId         String    @map("user_id")
  refreshTokenHash String  @unique @map("refresh_token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("sessions")
}

/// Single-use, expiring, hashed-at-rest email verification tokens.
model VerificationToken {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("verification_tokens")
}

/// Single-use, expiring, hashed-at-rest password reset tokens.
model PasswordResetToken {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("password_reset_tokens")
}

/// A teacher-owned class. Archived (not deleted) so later modules
/// (activities, assignments) can still reference a class that's no
/// longer active without a dangling foreign key.
model Class {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  teacherId         String    @map("teacher_id")
  name              String
  joinCode          String    @unique @map("join_code")
  joinCodeExpiresAt DateTime  @map("join_code_expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  archivedAt        DateTime? @map("archived_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  roster      RosterEntry[]
  assignments Assignment[]

  @@index([tenantId])
  @@index([teacherId])
  @@map("classes")
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
  short_text
  numeric
}

/// A teacher-owned question. The row itself only tracks identity and
/// ownership — all gradable content lives on `QuestionVersion`.
/// `currentVersionId` is nullable at the type level only because a
/// `Question` cannot reference its first `QuestionVersion` until that
/// row exists (the FK would be circular otherwise); the service layer
/// creates the `Question` and its v1 `QuestionVersion` in a single
/// Prisma transaction, so it is never observably null once the
/// create call returns. Archived (not deleted), matching `Class`.
model Question {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  teacherId        String    @map("teacher_id")
  currentVersionId String?   @unique @map("current_version_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  archivedAt       DateTime? @map("archived_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher User              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  versions QuestionVersion[] @relation("QuestionVersions")
  currentVersion QuestionVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  activityQuestions ActivityQuestion[] @relation("ActivityQuestionQuestion")
  concepts QuestionConcept[]

  @@index([tenantId])
  @@index([teacherId])
  @@map("questions")
}

/// Every edit to a `Question` unconditionally creates a new
/// `QuestionVersion` row rather than mutating in place — nothing can
/// "use" (reference) a question yet since Activities don't exist
/// until Module 4, so always-versioning is fully testable now and
/// avoids a conditional "only version if used" branch that would be
/// untestable until a later module. `tenantId` is denormalized here
/// (same pattern as `RosterEntry`) so tenant-scoped queries never need
/// to join through `Question`.
///
/// `correctAnswer` shape depends on `type`:
///  - single_choice: a single option id (string)
///  - multiple_choice: an array of option ids (string[])
///  - true_false: a boolean
///  - short_text: an array of accepted-answer strings
///  - numeric: `{ value: number, tolerance?: number }`
///
/// No answer-key protection is applied at this layer — Module 3 has
/// no learner-facing surface yet, so returning the full answer key to
/// any authenticated (teacher, tenant-scoped) request is an accepted,
/// documented limitation, not an oversight.
model QuestionVersion {
  id            String       @id @default(uuid())
  questionId    String       @map("question_id")
  tenantId      String       @map("tenant_id")
  versionNumber Int          @map("version_number")
  type          QuestionType
  prompt        String
  points        Int          @default(1)
  hint          String?
  explanation   String?
  options       Json?
  correctAnswer Json         @map("correct_answer")
  createdAt     DateTime     @default(now()) @map("created_at")

  question Question @relation("QuestionVersions", fields: [questionId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentFor Question? @relation("CurrentVersion")
  pinnedFor ActivityQuestion[] @relation("ActivityQuestionPinnedVersion")

  @@unique([questionId, versionNumber])
  @@index([tenantId])
  @@index([questionId])
  @@map("question_versions")
}

/// A lightweight, teacher-managed roster record. Module 2 created these
/// as placeholder rows with `userId` null (teacher-added, no login).
/// Module 5 adds real learner accounts: join-code redemption
/// (`ClassesService.redeemJoinCode`) always creates a brand-new
/// `RosterEntry` with `userId` set to the redeeming learner's `User.id`
/// — it never fuzzy-matches an existing placeholder row by name, so a
/// teacher-added placeholder and a learner's self-redeemed entry can
/// coexist for what is "the same person" in real life; reconciling that
/// is a future-module concern. Soft-deleted (removedAt) rather than
/// hard-deleted for an audit trail.
model RosterEntry {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  classId   String    @map("class_id")
  userId    String?   @map("user_id")
  name      String
  email     String?
  addedAt   DateTime  @default(now()) @map("added_at")
  removedAt DateTime? @map("removed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([classId])
  @@index([userId])
  @@map("roster_entries")
}

enum ActivityStatus {
  draft
  published
}

/// A teacher-owned quiz built from the question bank. While `draft`,
/// its `ActivityQuestion` rows resolve content live off each
/// question's current version. `publish()` is a one-time transition
/// (see ActivityQuestion doc comment) that pins every row's exact
/// version and is never reversible — a teacher wanting different
/// content creates a new activity instead of revising this one.
/// Archived (not deleted), matching `Class`/`Question`, and archiving
/// is allowed in any status since it only affects visibility, not the
/// pinned/live content itself.
model Activity {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  teacherId   String         @map("teacher_id")
  title       String
  status      ActivityStatus @default(draft)
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  archivedAt  DateTime?      @map("archived_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher     User               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  questions   ActivityQuestion[]
  assignments Assignment[]

  @@index([tenantId])
  @@index([teacherId])
  @@map("activities")
}

/// Join row between an `Activity` and a `Question`, ordered via
/// `order`. `pinnedVersionId` is null while the parent activity is
/// `draft` — content resolution always falls back to the question's
/// live `currentVersionId` in that state, so editing a question that's
/// only referenced by a draft activity is immediately visible in the
/// builder/preview. At publish time (`ActivitiesService.publish`),
/// one transaction sets `pinnedVersionId` on every row belonging to
/// the activity to each question's `currentVersionId` at that exact
/// moment. From then on, resolution always prefers `pinnedVersionId`
/// — this is what makes a published activity immutable even though
/// question versioning (Module 3) remains permanently unconditional:
/// later edits to the underlying question create new versions, but
/// this row keeps pointing at the version that existed at publish
/// time.
model ActivityQuestion {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  activityId      String    @map("activity_id")
  questionId      String    @map("question_id")
  pinnedVersionId String?   @map("pinned_version_id")
  order           Int
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity         Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  question         Question          @relation("ActivityQuestionQuestion", fields: [questionId], references: [id], onDelete: Cascade)
  pinnedVersion    QuestionVersion?  @relation("ActivityQuestionPinnedVersion", fields: [pinnedVersionId], references: [id])
  attemptResponses AttemptResponse[]

  @@index([activityId])
  @@index([tenantId])
  @@map("activity_questions")
}

/// Connects a PUBLISHED `Activity` to a `Class` with a due date. Creating
/// an assignment from a non-published activity is rejected at the
/// service layer — publish-immutability (Module 4) is what makes it
/// safe for `Attempt` grading to trust `ActivityQuestion.pinnedVersionId`
/// unconditionally. Only `dueAt` is patchable post-creation (scheduling
/// metadata, not content), matching the "structural mutation vs archive"
/// split used by `Activity`. Archived (not deleted), consistent with
/// every other module.
model Assignment {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  teacherId  String    @map("teacher_id")
  classId    String    @map("class_id")
  activityId String    @map("activity_id")
  dueAt      DateTime  @map("due_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  archivedAt DateTime? @map("archived_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher  User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class    Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  activity Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([tenantId])
  @@index([teacherId])
  @@index([classId])
  @@index([activityId])
  @@map("assignments")
}

enum AttemptStatus {
  in_progress
  submitted
}

/// A learner's single pass at an `Assignment`. `(assignmentId, learnerId)`
/// is unique — `AttemptsService.start` is idempotent and returns the
/// existing row on a repeat call instead of creating a duplicate.
/// Grading always resolves question content through the assignment's
/// activity's `ActivityQuestion.pinnedVersionId`, never the question's
/// live `currentVersionId` — see `ScoringService` for the fail-loud
/// guard if a pinned version is ever unexpectedly null.
model Attempt {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  assignmentId String        @map("assignment_id")
  learnerId    String        @map("learner_id")
  status       AttemptStatus @default(in_progress)
  startedAt    DateTime      @default(now()) @map("started_at")
  submittedAt  DateTime?     @map("submitted_at")
  score        Float?
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  learner    User               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  responses  AttemptResponse[]

  @@unique([assignmentId, learnerId])
  @@index([tenantId])
  @@index([assignmentId])
  @@index([learnerId])
  @@map("attempts")
}

/// One row per `ActivityQuestion` on the parent attempt's assignment's
/// activity, created empty at attempt-start time and filled in via
/// autosave. `isCorrect`/`pointsAwarded` stay null until submit grades
/// them exactly once (see the atomic claim pattern in
/// `AttemptsService.submit`).
model AttemptResponse {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  attemptId          String   @map("attempt_id")
  activityQuestionId String   @map("activity_question_id")
  responseValue      Json     @map("response_value")
  isCorrect          Boolean? @map("is_correct")
  pointsAwarded      Float?   @map("points_awarded")
  // Set true (via the attempts autosave/hint endpoints) the first time
  // a learner expands this question's hint on an in-progress attempt.
  // Never reset back to false. Frozen onto each recorded
  // MasteryEvidence row at grading time — see MasteryEvidence.
  hintViewed         Boolean  @default(false) @map("hint_viewed")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempt          Attempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  activityQuestion ActivityQuestion  @relation(fields: [activityQuestionId], references: [id], onDelete: Cascade)
  masteryEvidence  MasteryEvidence[]

  @@unique([attemptId, activityQuestionId])
  @@index([tenantId])
  @@index([attemptId])
  @@map("attempt_responses")
}

/// A teacher-owned mastery tag ("concept"). Concepts attach to
/// `Question`, not `QuestionVersion` — editing a question's wording
/// via the always-versioning flow (Module 3) doesn't require
/// re-tagging, and `PATCH /questions/:id/concepts` never bumps the
/// question's version. Concepts are teacher-scoped, not shared or
/// standardized across teachers (documented limitation). Archived
/// (not deleted), matching every other module.
model Concept {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  teacherId   String    @map("teacher_id")
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  archivedAt  DateTime? @map("archived_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher   User              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  questions QuestionConcept[]
  evidence  MasteryEvidence[]

  @@index([tenantId])
  @@index([teacherId])
  @@map("concepts")
}

/// Many-to-many join between `Question` and `Concept`. Replaced
/// wholesale by `PATCH /questions/:id/concepts` (full-set replacement,
/// not incremental add/remove) — see `QuestionsService`.
model QuestionConcept {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  questionId String   @map("question_id")
  conceptId  String   @map("concept_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([questionId, conceptId])
  @@index([tenantId])
  @@index([questionId])
  @@index([conceptId])
  @@map("question_concepts")
}

/// Append-only mastery evidence, written inside the SAME transaction
/// as attempt grading (`AttemptsService.submit`) — never a second
/// transaction, never backfilled. One row per (gradedResponse, tagged
/// concept). `responseScore` freezes
/// `(pointsAwarded / points) * (hintViewed ? 0.85 : 1.0)` at recording
/// time; `hintViewed` is frozen alongside it for auditability even
/// though it's derivable from the parent response. There is
/// deliberately no cached mastery table anywhere — `MasteryService`
/// aggregates these rows live, applying a recency half-life evaluated
/// against the actual current timestamp on every read, which is what
/// makes "practiced 3 weeks ago" score lower today than it did the day
/// it was recorded without ever re-writing a stored value.
/// `@@unique([attemptResponseId, conceptId])` makes duplicate evidence
/// for the same graded response structurally impossible, matching the
/// atomic-claim idempotency pattern `AttemptsService.submit` already
/// established: only the winning submit call ever reaches the code
/// that inserts these rows.
model MasteryEvidence {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  learnerId         String   @map("learner_id")
  conceptId         String   @map("concept_id")
  attemptResponseId String   @map("attempt_response_id")
  responseScore     Float    @map("response_score")
  hintViewed        Boolean  @map("hint_viewed")
  recordedAt        DateTime @default(now()) @map("recorded_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learner         User            @relation("MasteryEvidenceLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  concept         Concept         @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  attemptResponse AttemptResponse @relation(fields: [attemptResponseId], references: [id], onDelete: Cascade)

  @@unique([attemptResponseId, conceptId])
  @@index([tenantId])
  @@index([learnerId])
  @@index([conceptId])
  @@map("mastery_evidence")
}
